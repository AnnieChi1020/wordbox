# Next.js（本地開發放在 .env.local；值來自 `npx supabase status`）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENAI_API_KEY=          # 僅伺服器端
OPENAI_MODEL=            # 例：支援 structured outputs 的模型
AI_MOCK=0                # 1 = 使用 fixtures，不呼叫 OpenAI（NFR6）

# Supabase CLI（本地開發放在 .env；supabase/config.toml 以 env() 讀取）
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
